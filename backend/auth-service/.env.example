# Database
DATABASE_URL=sqlite:///./smart_identity.db

# JWT Security
SECRET_KEY=replace_with_a_secure_random_secret_of_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Email Verification
EMAIL_VERIFICATION_DEV_MODE=true

# Frontend URLs
FRONTEND_VERIFY_BASE_URL=http://localhost:3000/verify-email
FRONTEND_RESET_PASSWORD_BASE_URL=http://localhost:3000/reset-password

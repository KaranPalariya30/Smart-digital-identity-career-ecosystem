# Blockchain connection (points at the local Hardhat node by default)
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
# Path to the deployment artifact written by blockchain/scripts/deploy.js
DEPLOYMENT_ARTIFACT_PATH=../../blockchain/deployments/localhost-deployment.json

# Issuer account this service signs transactions with. In development this
# is a Hardhat test account private key (safe, holds only test ETH). In
# production this MUST come from a secrets manager, never a committed file.
ISSUER_PRIVATE_KEY=

# Database (adjust to whatever the team's shared Postgres instance is)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_ecosystem

# Used to build QR verification URLs. Swap for the real frontend domain
# once it exists.
FRONTEND_VERIFY_BASE_URL=http://localhost:5173/verify

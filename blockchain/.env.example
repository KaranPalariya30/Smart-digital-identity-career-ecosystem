# Local Hardhat network (default when running `npx hardhat node`)
LOCAL_RPC_URL=http://127.0.0.1:8545

# Optional: only needed for a real testnet deployment (e.g. Sepolia).
# Leave blank for local-only development.
TESTNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Filled in automatically by scripts/deploy.js after a local deploy.
# The backend service reads this to know which contract to talk to.
CONTRACT_ADDRESS=
